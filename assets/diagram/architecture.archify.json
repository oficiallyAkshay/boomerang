    {
      "dot": "cyan",
      "title": "Code does the mechanical work",
      "items": [
        "clean.py strips vendor markup from fetched mail",
        "cards.py fingerprints the card that paid",
        "build.py, render_pdf.py and attach_pdf.py make the packet"
      ]
    },
    {
      "dot": "rose",
      "title": "The model supplies judgment",
      "items": [
        "Which trip the receipts belong to, and how wide to pad the window",
        "How policy.md and policy.local.md apply to each receipt",
        "One candidate list, one question, before anything is built"
      ]
    },
    {
      "dot": "emerald",
      "title": "What runs in parallel",
      "items": [
        "Two search passes run before a single fetch stage",
        "Cleaning, card matching and folio text run over the same receipts at once",
        "The packet stage is strictly sequential: build, render, splice"
      ]
